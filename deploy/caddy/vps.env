# VPS Contabo (161.97.178.169) — nextsensus.com
# DNS (Squarespace): registros A "app" e "survey" -> 161.97.178.169
# Certificados Let's Encrypt automáticos; o desafio TLS-ALPN roda na 443,
# então a porta 80 pode continuar com o nginx enquanto ele existir.
#
# O Caddyfile do VPS (/etc/caddy/Caddyfile) importa este site junto com o
# bloco já existente do TNG Report (https://161.97.178.169).
CADDY_GLOBAL=auto_https disable_redirects
TLS=
APP_HOST=app.nextsensus.com
SURVEY_HOST=survey.nextsensus.com
# Chamadas servidor->servidor (jobs do Fluent -> /svc) saem pelo IP público.
SERVER_IPS=127.0.0.1/8 ::1 161.97.178.169
FLUENT_UPSTREAM=127.0.0.1:8000
ENGINE_UPSTREAM=127.0.0.1:8001
FLASK_UPSTREAM=127.0.0.1:8002
EXPRESS_UPSTREAM=127.0.0.1:8003
ACT_UPSTREAM=127.0.0.1:8004
EXPRESS_ENGINE_DIST=/var/www/enquire-express-engine/dist
