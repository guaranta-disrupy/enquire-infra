# Caddyfile do VPS — copiado para /etc/caddy/Caddyfile no deploy.
# Variáveis de enquire.caddy vêm de vps.env (EnvironmentFile no drop-in
# /etc/systemd/system/caddy.service.d/enquire.conf).
{
	# Os sites internos do php-fpm (php.caddy) recebem do próprio Caddy: mantém
	# X-Forwarded-Proto/For/Host vindos de 127.0.0.1.
	servers {
		trusted_proxies static 127.0.0.1/32 ::1/128
	}
}

# Access log por produto. Sem isto não há COMO saber se uma tentativa de acesso
# chegou ao servidor: o journal do Caddy só guarda TLS/ACME e o gunicorn, sem
# --access-logfile, só fala quando quebra. Já custou uma investigação às cegas.
# `roll_keep_for` limita o histórico; `roll_size`/`roll_keep` limitam o disco.
(tnglog) {
	log {
		output file /var/log/caddy/{args[0]}.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}
}

# --- Produtos TNG -----------------------------------------------------------
report.nextsensus.com {
	import tnglog report
	encode zstd gzip
	reverse_proxy 127.0.0.1:8005
}

pricing.nextsensus.com {
	import tnglog pricing
	encode zstd gzip
	request_body {
		max_size 5MB
	}
	reverse_proxy 127.0.0.1:8006
}

field.nextsensus.com {
	import tnglog field
	encode zstd gzip
	request_body {
		max_size 25MB
	}

	# Backend (Django-Ninja): API, admin e estáticos do admin.
	@backend path /api/* /admin /admin/* /static/*
	handle @backend {
		reverse_proxy 127.0.0.1:8007
	}

	# App (PWA estático, build de tng-fieldwork-app em /var/www/tng-fieldwork-web).
	handle {
		root * /var/www/tng-fieldwork-web
		# O service worker e o manifest não podem ficar presos em cache.
		@sw path /sw.js /manifest.webmanifest /index.html
		header @sw Cache-Control "no-cache"
		header /manifest.webmanifest Content-Type application/manifest+json
		try_files {path} /index.html
		file_server
	}
}

# Acesso antigo do TNG Report pelo IP. O certificado aqui é INTERNO (Caddy Local
# Authority, 12h de validade), então todo browser barra a entrada com aviso de
# certificado — foi exatamente assim que um usuário ficou sem conseguir entrar.
# O endereço para divulgar é report.nextsensus.com; este vhost existe só para
# quem ainda tem o link velho, e o log separado mostra quem ainda o usa.
https://161.97.178.169 {
	import tnglog report-ip
	tls internal
	reverse_proxy 127.0.0.1:8005
}

# --- Enquire / Fluent ------------------------------------------------------
import /var/www/enquire-infra/deploy/caddy/enquire.caddy
import /var/www/enquire-infra/deploy/caddy/php.caddy
