# Caddyfile do VPS — copiado para /etc/caddy/Caddyfile no deploy.
# Variáveis de enquire.caddy vêm de vps.env (EnvironmentFile no drop-in
# /etc/systemd/system/caddy.service.d/enquire.conf).
{
	# Os sites internos do php-fpm (php.caddy) recebem do próprio Caddy: mantém
	# X-Forwarded-Proto/For/Host vindos de 127.0.0.1.
	servers {
		trusted_proxies static 127.0.0.1/32 ::1/128
	}
}

# --- Produtos TNG -----------------------------------------------------------
report.nextsensus.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8005
}

pricing.nextsensus.com {
	encode zstd gzip
	request_body {
		max_size 5MB
	}
	reverse_proxy 127.0.0.1:8006
}

field.nextsensus.com {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy 127.0.0.1:8007
}

# Acesso antigo do TNG Report pelo IP (certificado autoassinado).
https://161.97.178.169 {
	tls internal
	reverse_proxy 127.0.0.1:8005
}

# --- Enquire / Fluent ------------------------------------------------------
import /var/www/enquire-infra/deploy/caddy/enquire.caddy
import /var/www/enquire-infra/deploy/caddy/php.caddy
